# syntax=docker/dockerfile:1.7

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV AI_HOST=0.0.0.0
ENV AI_PORT=9000
ENV AI_SERVICE_NAME=ai-service
ENV AI_SERVICE_VERSION=0.5.0

WORKDIR /service

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir fastapi==0.115.6 uvicorn[standard]==0.34.0 pydantic==2.10.4

RUN addgroup --system appgroup \
    && adduser --system --ingroup appgroup --home /service appuser

COPY src/ai_service/ ./
RUN chown -R appuser:appgroup /service

USER appuser

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9000/health', timeout=3).read()" || exit 1

CMD ["sh", "-c", "uvicorn main:app --host ${AI_HOST} --port ${AI_PORT}"]
